// ════════════════════════════════════════════════════════════════════

function buildBlock(b, tab) {
  const wrap = document.createElement('div');
  wrap.className = 'block';
  wrap.dataset.id = b.id;
  wrap.dataset.tab = tab;
  wrap.setAttribute('data-block-id', b.id);

  const header = document.createElement('div'); header.className = 'btop';
  const left   = document.createElement('div'); left.className   = 'btop-left';

  const ddWrap = document.createElement('div'); ddWrap.className = 'rdd';
  const ddBtn  = document.createElement('button');
  ddBtn.className = 'rddbtn ' + DD_CLS[b.role];
  ddBtn.innerHTML = DD_LABEL[b.role] + ' ▾';
  if (canEdit()) ddBtn.onclick = ev => { ev.stopPropagation(); openRoleDropdown(ddBtn, b, tab); };
  else ddBtn.style.cssText = 'cursor:default;pointer-events:none';
  ddWrap.appendChild(ddBtn); left.appendChild(ddWrap); header.appendChild(left);

  if (canEdit()) {
    const delBtn = document.createElement('button');
    delBtn.className = 'cbtn del'; delBtn.innerHTML = '🗑'; delBtn.title = 'Supprimer';
    delBtn.onclick = () => deleteBlock(b.id, tab);
    const controls = document.createElement('div'); controls.className = 'bctrl';
    controls.appendChild(delBtn); header.appendChild(controls);
  }
  wrap.appendChild(header);

  const content =
    b.type === 'text'      ? buildText(b, tab) :
    b.type === 'table'     ? buildTable(b, tab) :
    b.type === 'checklist' ? buildChecklist(b, tab) :
    b.type === 'image'     ? buildImage(b, tab) :
    b.type === 'kit'       ? buildKit(b) : null;

  if (content) wrap.appendChild(content);
  if (canComment()) wrap.appendChild(buildComments(b, tab));
  return wrap;
}

function rerenderBlock(id, tab) {
  const b = blocks[tab].find(x => x.id === id); if (!b) return;
  const old = document.querySelector(`[data-id="${id}"]`); if (!old) return;
  old.replaceWith(buildBlock(b, tab));
  saveBlock(b, tab);
}

// ── Text ─────────────────────────────────────────────────────────────
function buildText(b, tab) {
  const wrap = document.createElement('div');

  const titleEl = document.createElement('input');
  titleEl.className = 'btinput'; titleEl.type = 'text'; titleEl.value = b.title;
  titleEl.readOnly = !canEdit();
  if (canEdit()) titleEl.oninput = () => { b.title = titleEl.value; saveBlock(b, tab); };
  wrap.appendChild(titleEl);

  if (canEdit()) {
    const ta = document.createElement('textarea');
    ta.className = 'bbinput'; ta.value = b.body || ''; ta.rows = 3;
    ta.oninput = () => { autoResize(ta); b.body = ta.value; saveBlock(b, tab); };
    wrap.appendChild(ta);
    setTimeout(() => autoResize(ta), 0);
  } else {
    const div = document.createElement('div');
    div.className = 'bbinput'; div.style.cursor = 'default';
    div.appendChild(smartRender(b.body || ''));
    wrap.appendChild(div);
  }
  return wrap;
}

// ── Table ─────────────────────────────────────────────────────────────
function buildTable(b, tab) {
  const wrap = document.createElement('div');

  const titleEl = document.createElement('input');
  titleEl.className = 'btinput'; titleEl.type = 'text'; titleEl.value = b.title;
  titleEl.readOnly = !canEdit();
  if (canEdit()) titleEl.oninput = () => { b.title = titleEl.value; };
  wrap.appendChild(titleEl);

  if (canEdit()) {
    const bar = document.createElement('div'); bar.className = 'tacts';
    bar.appendChild(makeSmallBtn('＋ Ligne', () => {
      b.rows.push(Array(b.cols.length).fill(''));
      rerenderBlock(b.id, tab); showToast('Ligne ajoutée');
    }));
    bar.appendChild(makeSmallBtn('＋ Colonne', () => {
      b.cols.push('Colonne'); b.rows.forEach(r => r.push(''));
      rerenderBlock(b.id, tab); showToast('Colonne ajoutée');
    }));
    wrap.appendChild(bar);
  }

  const tableWrap = document.createElement('div'); tableWrap.className = 'twrap';
  const table = document.createElement('table');

  const thead = document.createElement('thead');
  const headRow = document.createElement('tr');
  b.cols.forEach((col, ci) => {
    const th = document.createElement('th'); th.textContent = col;
    if (canEdit()) { th.contentEditable = 'true'; th.oninput = () => { b.cols[ci] = th.textContent; saveBlock(b, tab); }; }
    headRow.appendChild(th);
  });
  thead.appendChild(headRow); table.appendChild(thead);

  const tbody = document.createElement('tbody');
  b.rows.forEach((row, ri) => {
    const tr = document.createElement('tr');
    row.forEach((cell, ci) => {
      const td = document.createElement('td');
      if (canEdit()) {
        td.textContent = cell; td.contentEditable = 'true';
        td.oninput = () => { b.rows[ri][ci] = td.innerText.trim(); saveBlock(b, tab); };
      } else {
        td.appendChild(renderCellContent(cell));
      }
      tr.appendChild(td);
    });
    tbody.appendChild(tr);
  });
  table.appendChild(tbody); tableWrap.appendChild(table); wrap.appendChild(tableWrap);
  return wrap;
}

// ── Checklist ──────────────────────────────────────────────────────────
function buildChecklist(b, tab) {
  const wrap = document.createElement('div');

  const titleEl = document.createElement('input');
  titleEl.className = 'btinput'; titleEl.type = 'text'; titleEl.value = b.title;
  titleEl.readOnly = !canEdit();
  if (canEdit()) titleEl.oninput = () => { b.title = titleEl.value; };
  wrap.appendChild(titleEl);

  const list = document.createElement('div');
  (b.items || []).forEach(item => list.appendChild(buildCheckItem(item, b, tab)));
  wrap.appendChild(list);

  if (canEdit()) {
    const btn = makeSmallBtn('＋ Ajouter une tâche', () => {
      b.items.push({ id:'i'+Date.now(), text:'Nouvelle tâche', checked:false, assignee:'' });
      rerenderBlock(b.id, tab);
    });
    btn.className += ' mt12';
    wrap.appendChild(btn);
  }
  return wrap;
}

function buildCheckItem(item, b, tab) {
  const row = document.createElement('div');
  row.className = 'chkitem' + (item.checked ? ' done' : '');

  const cb = document.createElement('input'); cb.type = 'checkbox'; cb.className = 'ccb'; cb.checked = item.checked;
  cb.onchange = () => { item.checked = cb.checked; row.classList.toggle('done', cb.checked); saveBlock(b, tab); showToast(cb.checked ? '✅ Cochée !' : 'Décochée'); };

  const label = document.createElement('input'); label.type = 'text'; label.className = 'clabel'; label.value = item.text;
  label.readOnly = !canEdit();
  if (canEdit()) label.oninput = () => { item.text = label.value; };

  row.appendChild(cb); row.appendChild(label);
  if (item.assignee) {
    const tag = document.createElement('span'); tag.className = 'atag'; tag.textContent = '👤 ' + item.assignee;
    row.appendChild(tag);
  }
  return row;
}

// ── Image ──────────────────────────────────────────────────────────────
function buildImage(b, tab) {
  const wrap = document.createElement('div');

  const titleEl = document.createElement('input');
  titleEl.className = 'btinput'; titleEl.type = 'text'; titleEl.value = b.title;
  titleEl.readOnly = !canEdit();
  if (canEdit()) titleEl.oninput = () => { b.title = titleEl.value; };
  wrap.appendChild(titleEl);

  const fileInput = document.createElement('input');
  fileInput.type = 'file'; fileInput.accept = 'image/*'; fileInput.multiple = true; fileInput.className = 'hidden';
  fileInput.onchange = () => {
    Array.from(fileInput.files).forEach(file => {
      if (file.size > 5 * 1024 * 1024) return showToast('Max 5MB par image');
      const reader = new FileReader();
      reader.onload = e => {
        if (!b.images) b.images = [];
        b.images.push(e.target.result);
        rerenderBlock(b.id, tab); showToast('Photo ajoutée 🌸');
      };
      reader.readAsDataURL(file);
    });
  };
  wrap.appendChild(fileInput);

  if (!b.images?.length) {
    const zone = document.createElement('div'); zone.className = 'izone';
    zone.innerHTML = '<div class="izone-ico">📷</div><div class="izone-txt">Clique pour ajouter des photos<br><span style="font-size:.67rem;opacity:.7">JPG, PNG, max 5MB</span></div>';
    zone.onclick = () => fileInput.click();
    wrap.appendChild(zone);
  } else {
    const addBtn = makeSmallBtn('＋ Ajouter des photos', () => fileInput.click());
    addBtn.className += ' mt8'; wrap.appendChild(addBtn);
    const grid = document.createElement('div'); grid.className = 'igrid mt8';
    b.images.forEach((src, i) => {
      const thumb = document.createElement('div'); thumb.className = 'ithumb';
      const img = document.createElement('img'); img.src = src; img.onclick = () => openLightbox(src);
      thumb.appendChild(img);
      if (canEdit()) {
        const del = document.createElement('button'); del.className = 'idelbtn'; del.textContent = '✕';
        del.onclick = ev => { ev.stopPropagation(); b.images.splice(i, 1); rerenderBlock(b.id, tab); saveBlock(b, tab); showToast('Photo supprimée'); };
        thumb.appendChild(del);
      }
      grid.appendChild(thumb);
    });
    wrap.appendChild(grid);
  }
  return wrap;
}

