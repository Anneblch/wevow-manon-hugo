async function deleteBlock(id, tab) {
  if (!confirm('Supprimer ce bloc ?')) return;
  const { error } = await sb.from('blocks').delete().eq('id', id);
  if (error) return showToast('Erreur suppression ⚠️');
  blocks[tab] = blocks[tab].filter(b => b.id !== id);
  renderTab(tab);
  showToast('Bloc supprimé');
}

async function addBlock(type) {
  const role = document.getElementById('mrol').value;
  const id   = 'b' + Date.now();
  const base = { id, type, role, comments:[] };
  const defs = {
    text:      { title:'Nouveau bloc', body:'Écrivez ici...' },
    table:     { title:'Nouveau tableau', cols:['Colonne 1','Colonne 2','Colonne 3'], rows:[['','','']] },
    checklist: { title:'Nouvelle checklist', items:[{ id:'i1', text:'Première tâche', checked:false, assignee:'' }] },
    image:     { title:'Nouvelles photos', images:[] },
  };
  if (!defs[type]) { closeModal(); return; }
  const b = { ...base, ...defs[type] };
  blocks[AT].push(b);
  renderTab(AT);
  closeModal();
  saveBlock(b, AT).catch(err => { showToast('Erreur sauvegarde'); console.error(err); });
}

