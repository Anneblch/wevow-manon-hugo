function initCD() {
  renderCD('cd-evjf',  ED, '🥂 EVJF — 23 Mai 2026');
  renderCD('cd-jourj', WD, '💍 Mariage — 4 Juillet 2026');
  setInterval(() => {
    renderCD('cd-evjf',  ED, '🥂 EVJF — 23 Mai 2026');
