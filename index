async function loadBlocks() {
  try {
    const { data, error } = await sb.from('blocks')
      .select('*').eq('event_slug', SLUG)
      .order('tab').order('block_order');

    if (error || !data?.length) {
      blocks = JSON.parse(JSON.stringify(DB));
      await seedBlocks();
    } else {
      blocks = { evjf:[], mariage:[], jourj:[] };
      data.forEach(r => {
        if (!blocks[r.tab]) return;
        blocks[r.tab].push({ id:r.id, type:r.type, role:r.role, title:r.title, comments:[], ...r.content });
      });
      await loadComments();
    }
  } catch(err) {
    console.error('loadBlocks:', err);
    blocks = JSON.parse(JSON.stringify(DB));
  }
}

async function loadComments() {
  try {
    const ids = [...blocks.evjf, ...blocks.mariage, ...blocks.jourj].map(b => b.id);
    if (!ids.length) return;
    const { data, error } = await sb.from('comments')
      .select('*').in('block_id', ids).order('created_at');
    if (error) throw error;
    data?.forEach(r => {
      for (const tab of ['evjf','mariage','jourj']) {
        const b = blocks[tab].find(x => x.id === r.block_id);
        if (b) { b.comments.push(fmtComment(r)); break; }
      }
    });
  } catch(err) { console.error('loadComments:', err); }
}

function fmtComment(r) {
  return {
    id: r.id, name: r.author_name, role: r.author_role, body: r.body,
    time: new Date(r.created_at).toLocaleTimeString('fr-FR', { hour:'2-digit', minute:'2-digit' })
  };
}

async function seedBlocks() {
  const rows = [];
  for (const tab of ['evjf','mariage','jourj']) {
    blocks[tab].forEach((b, i) => {
      const { id, type, role, title, comments, ...rest } = b;
      rows.push({ id, event_slug:SLUG, tab, block_order:i, type, role, title, content:rest });
    });
  }
  if (!rows.length) return;
  try {
    const { error } = await sb.from('blocks').upsert(rows, { onConflict:'id', ignoreDuplicates:true });
    if (error) throw error;
  } catch(err) { console.error('seedBlocks:', err); }
}

let _saveTimer = null;
async function saveBlock(b, tab) {
  clearTimeout(_saveTimer);
  _saveTimer = setTimeout(async () => {
    try {
      const { id, type, role, title, comments, ...rest } = b;
      const order = blocks[tab]?.findIndex(x => x.id === id) ?? 0;
      const { error } = await sb.from('blocks').upsert(
        { id, event_slug:SLUG, tab, block_order:order, type, role, title, content:rest, updated_at:new Date().toISOString() },
        { onConflict:'id' }
      );
      if (error) throw error;
      showToast('Enregistré ✓');
    } catch(err) {
      showToast('Erreur de sauvegarde ⚠️');
      console.error('saveBlock:', err);
    }
  }, 800);
}

async function saveComment(blockId, text) {
  try {
    const { data, error } = await sb.from('comments').insert({
      block_id: blockId,
      author_name: CU.name,
      author_role: CU.role,
      body: text
