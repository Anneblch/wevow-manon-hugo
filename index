/* TOAST */
.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(60px);background:var(–text);color:white;padding:10px 18px;border-radius:11px;font-size:.78rem;box-shadow:0 8px 24px rgba(0,0,0,.2);z-index:9999;opacity:0;transition:all .3s ease;white-space:nowrap;display:flex;align-items:center;gap:7px;max-width:90vw}
