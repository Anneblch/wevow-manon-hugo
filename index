.block{padding:18px 13px}.btinput{font-size:1.1rem}
.urole{display:none}
.cdw{padding:16px 14px}.cdv{font-size:1.6rem}
.kgrid{grid-template-columns:repeat(auto-fill,minmax(88px,1fr))}
}
