// CALENDAR
// ════════════════════════════════════════════════════════════════════

let _calPopup = null;
const CAL_ICON_SVG = '<svg viewBox="0 0 16 16" fill="none"><rect x="1.5" y="2.5" width="13" height="12" rx="2" stroke="currentColor" stroke-width="1.3"/><line x1="5" y1="1" x2="5" y2="4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><line x1="11" y1="1" x2="11" y2="4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><line x1="1.5" y1="6.5" x2="14.5" y2="6.5" stroke="currentColor" stroke-width="1.3"/></svg>';

function showCalPop(e, task, date) {
  e.stopPropagation();
  if (_calPopup) { _calPopup.remove(); _calPopup = null; return; }
  const p = document.createElement('div'); p.className = 'cpopup';
  const title = document.createElement('div'); title.className = 'cpopup-title'; title.textContent = 'Ajouter au calendrier';
  p.appendChild(title);
  const addItem = (icon, label, action) => {
    const btn = document.createElement('button'); btn.className = 'cpopup-item';
    btn.innerHTML = `<span style="font-size:1rem">${icon}</span>${label}`;
    btn.onclick = () => { action(); _calPopup = null; };
    p.appendChild(btn);
  };
  addItem('🍎', 'Apple / iCal', () => {
    const blob = new Blob([makeICS(task, date)], { type:'text/calendar;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a'); a.href = url;
    a.download = 'wevow-' + task.replace(/[^a-z0-9]/gi,'-').toLowerCase().slice(0,28) + '.ics';
    a.click(); URL.revokeObjectURL(url);
    showToast('Ouvre le fichier .ics pour ajouter 📅');
  });
  addItem('🔵', 'Google Agenda', () => {
    const enc = encodeURIComponent('💍 ' + task + ' — WeVow');
    window.open('https://www.google.com/calendar/render?action=TEMPLATE&text=' + enc + '&dates=20260704/20260705', '_blank');
  });
  document.body.appendChild(p);
  const rect = e.target.getBoundingClientRect();
  let left = rect.left, top = rect.bottom + 6;
  if (left + (p.offsetWidth||195) > window.innerWidth - 10) left = window.innerWidth - (p.offsetWidth||195) - 10;
  if (top + p.offsetHeight > window.innerHeight - 10) top = rect.top - p.offsetHeight - 6;
  p.style.left = Math.max(8, left) + 'px'; p.style.top = Math.max(8, top) + 'px';
  _calPopup = p;
  setTimeout(() => {
    document.addEventListener('click', function closeCalPop() {
      _calPopup?.remove(); _calPopup = null;
      document.removeEventListener('click', closeCalPop);
    });
  }, 0);
}

function makeICS(title, dateHint) {
  const stamp = new Date().toISOString().replace(/[-:.]/g,'').slice(0,15)+'Z';
  return [
    'BEGIN:VCALENDAR','VERSION:2.0','PRODID:-//WeVow//FR','CALSCALE:GREGORIAN',
    'BEGIN:VEVENT','UID:wevow-'+Date.now()+'@wevow.app','DTSTAMP:'+stamp,
    'DTSTART;VALUE=DATE:20260704','DTEND;VALUE=DATE:20260705',
    'SUMMARY:'+title+' — WeVow','DESCRIPTION:'+title+(dateHint?' ('+dateHint+')':''),
    'BEGIN:VALARM','TRIGGER:-P1D','ACTION:DISPLAY','DESCRIPTION:Rappel J-1 : '+title,'END:VALARM',
    'END:VEVENT','END:VCALENDAR'
  ].join('\r\n');
}

function injectCalBtns() {
  const block = document.querySelector('[data-id="m2"]'); if (!block) return;
  block.querySelectorAll('tbody tr').forEach(tr => {
    if (tr.querySelector('.cal-pill')) return;
    const cells = tr.querySelectorAll('td'); if (cells.length < 2) return;
    const dateText = cells[0].textContent.trim();
    const taskText = cells[1].textContent.trim(); if (!taskText) return;
    const pill = document.createElement('button'); pill.className = 'cal-pill';
    pill.title = 'Ajouter au calendrier'; pill.innerHTML = CAL_ICON_SVG;
    pill.onclick = ev => showCalPop(ev, taskText, dateText);
    const lastTd = cells[cells.length - 1];
    lastTd.appendChild(document.createTextNode(' ')); lastTd.appendChild(pill);
  });
}

let _calObserver = null;
function startCalObs() {
  if (_calObserver) return;
  const el = document.getElementById('blk-mariage'); if (!el) return;
  _calObserver = new MutationObserver(() => { clearTimeout(window._calT); window._calT = setTimeout(injectCalBtns, 300); });
  _calObserver.observe(el, { childList:true, subtree:true });
}

