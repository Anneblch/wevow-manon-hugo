

<!DOCTYPE html>

<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>WeVow · Manon & Hugo 2026</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>

:root {
–rose:#E8C4C4;–rose-deep:#C9999A;–rose-light:#F7EAEA;–rose-mid:#DEB8B8;
–beige:#F2EAD3;–beige-dark:#E0D3B4;–beige-mid:#EDE3C8;
–sage:#8B9E8A;–sage-light:#B5C4B1;–sage-dark:#5E6E5D;
–cream:#FBF8F2;–brown:#8C7560;
–text:#3D332A;–text-mid:#7A6E64;–text-light:#A89E94;
–white:#FEFCFA;
–sh:0 4px 20px rgba(100,80,60,0.1);–sh2:0 10px 40px rgba(100,80,60,0.16);
–r:16px;–rs:10px;
}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
body{font-family:‘Jost’,sans-serif;background:var(–cream);color:var(–text);min-height:100dvh;overscroll-behavior:none}
body::before{content:’’;position:fixed;inset:0;background:radial-gradient(ellipse at 5% 8%,rgba(232,196,196,.25) 0%,transparent 45%),radial-gradient(ellipse at 95% 15%,rgba(181,196,177,.2) 0%,transparent 40%),radial-gradient(ellipse at 75% 88%,rgba(232,196,196,.18) 0%,transparent 38%);pointer-events:none;z-index:0}
::-webkit-scrollbar{width:5px}::-webkit-scrollbar-thumb{background:var(–beige-dark);border-radius:5px}

/* LOGIN */
#login-screen{position:fixed;inset:0;z-index:1000;display:flex;align-items:center;justify-content:center;padding:16px;background:linear-gradient(160deg,#f7ede8 0%,#f2ebd3 40%,#e8edd8 75%,#eee5d4 100%)}
.lcard{background:rgba(254,252,250,.97);border-radius:26px;padding:44px 34px 36px;width:430px;max-width:100%;box-shadow:0 24px 64px rgba(140,110,90,.22);border:1px solid rgba(201,153,154,.28);position:relative;overflow:hidden;text-align:center}
.lcard::before{content:’’;position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(–rose-deep),var(–sage-light),var(–beige-dark),var(–rose-deep));background-size:200%;animation:shimmer 3s linear infinite}
.lcard::after{content:’’;position:absolute;bottom:0;left:0;right:0;height:120px;background:linear-gradient(0deg,rgba(242,234,211,.35) 0%,transparent 100%);pointer-events:none}
@keyframes shimmer{0%{background-position:0%}100%{background-position:200%}}
.lflowers{font-size:1.6rem;letter-spacing:5px;margin-bottom:10px}
.ltitle{font-family:‘Cormorant Garamond’,serif;font-size:1.9rem;font-weight:400;color:var(–text);margin-bottom:3px}
.ltitle em{color:var(–rose-deep);font-style:italic}
.ldate{font-size:.68rem;letter-spacing:3px;text-transform:uppercase;color:var(–text-light);margin-bottom:12px}
.ltoast{background:rgba(139,158,138,.1);border:1px solid rgba(139,158,138,.25);border-radius:var(–rs);padding:10px 13px;font-size:.74rem;line-height:1.6;color:var(–sage-dark);margin-bottom:20px;text-align:left}
.llabel{font-size:.63rem;letter-spacing:2.5px;text-transform:uppercase;color:var(–text-mid);text-align:left;margin-bottom:9px}
.rgrid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:18px}
.rbtn{padding:13px 6px;border:1.5px solid var(–beige-dark);border-radius:12px;background:var(–white);cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:4px;transition:all .2s}
.rbtn:hover{border-color:var(–rose-deep);background:var(–rose-light);transform:translateY(-1px)}
.rbtn.active{border-color:var(–rose-deep);background:linear-gradient(135deg,var(–rose-light),var(–beige));box-shadow:0 4px 14px rgba(201,153,154,.28)}
.rico{font-size:1.5rem}.rname{font-size:.6rem;letter-spacing:.8px;text-transform:uppercase;color:var(–text-mid);line-height:1.3;text-align:center}
.linput{width:100%;padding:12px 15px;border:1.5px solid var(–beige-dark);border-radius:var(–rs);font-family:‘Jost’,sans-serif;font-size:.9rem;color:var(–text);background:var(–white);outline:none;transition:border-color .2s;margin-bottom:9px;display:block}
.linput:focus{border-color:var(–rose-deep)}
.lbtn{width:100%;padding:15px;background:linear-gradient(135deg,#C9999A 0%,#C0A882 50%,#8B9E8A 100%);border:none;border-radius:12px;color:white;font-family:‘Jost’,sans-serif;font-size:.78rem;letter-spacing:3px;text-transform:uppercase;cursor:pointer;font-weight:500;margin-top:8px;transition:all .25s;box-shadow:0 6px 20px rgba(201,153,154,.38);letter-spacing:2px}
.lbtn:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(201,153,154,.4)}
.lerr{font-size:.74rem;color:#c46;background:rgba(204,68,102,.08);border-radius:8px;padding:8px 12px;margin-top:8px}

/* APP */
#app{display:none;position:relative;z-index:1}

/* HEADER */
header{background:rgba(254,252,250,.92);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);border-bottom:1px solid rgba(232,196,196,.3);padding:0 18px;height:56px;position:sticky;top:0;z-index:200;display:flex;align-items:center;justify-content:space-between}
.hbrand{font-family:‘Cormorant Garamond’,serif;font-size:1.1rem;color:var(–text)}
.hbrand em{color:var(–rose-deep);font-style:italic}
.hright{display:flex;align-items:center;gap:9px}
.upill{display:flex;align-items:center;gap:7px;padding:4px 11px 4px 4px;background:var(–rose-light);border:1px solid rgba(201,153,154,.22);border-radius:100px}
.uav{width:27px;height:27px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.72rem;font-weight:600;color:white;background:linear-gradient(135deg,var(–rose-deep),var(–sage-light))}
.uname{font-size:.76rem;font-weight:500;color:var(–text)}.urole{font-size:.58rem;color:var(–rose-deep);letter-spacing:1px;text-transform:uppercase}
.qbtn{background:none;border:none;cursor:pointer;font-size:.65rem;color:var(–text-light);padding:5px 7px;border-radius:7px;letter-spacing:1px;text-transform:uppercase;transition:all .2s}
.qbtn:hover{color:var(–rose-deep);background:var(–rose-light)}

/* TABS */
.tnav{background:rgba(254,252,250,.88);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom:1px solid rgba(232,196,196,.22);display:flex;overflow-x:auto;padding:0 6px;position:sticky;top:56px;z-index:190;scrollbar-width:none}
.tnav::-webkit-scrollbar{display:none}
.tbtn{flex-shrink:0;padding:0 16px;height:46px;border:none;background:none;cursor:pointer;display:flex;align-items:center;gap:5px;font-family:‘Jost’,sans-serif;font-size:.7rem;letter-spacing:2px;text-transform:uppercase;color:var(–text-light);position:relative;transition:color .2s;white-space:nowrap}
.tbtn::after{content:’’;position:absolute;bottom:0;left:12px;right:12px;height:2px;border-radius:2px 2px 0 0;background:linear-gradient(90deg,var(–rose-deep),var(–sage));transform:scaleX(0);transition:transform .25s ease}
.tbtn.active{color:var(–text);font-weight:500}.tbtn.active::after{transform:scaleX(1)}
.ticon{font-size:.95rem}

/* MAIN */
main{max-width:840px;margin:0 auto;padding:24px 14px 80px}

/* SECTION HEAD */
.shead{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:20px;padding-bottom:16px;border-bottom:1px solid rgba(224,211,180,.45);flex-wrap:wrap;gap:10px}
.semoji{font-size:1.45rem;margin-bottom:2px}
.stitle{font-family:‘Cormorant Garamond’,serif;font-size:2.1rem;font-weight:400;line-height:1}
.stitle em{color:var(–rose-deep);font-style:italic}
.ssub{font-size:.68rem;color:var(–text-light);letter-spacing:2px;text-transform:uppercase;margin-top:4px}

/* TAB CONTENT */
.tcontent{display:none}.tcontent.active{display:block;animation:fadeUp .28s ease}
@keyframes fadeUp{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}

/* ADD BAR */
.abar{display:flex;gap:7px;margin-bottom:18px;flex-wrap:wrap}
.abtn{display:flex;align-items:center;gap:5px;padding:8px 15px;border-radius:100px;border:1.5px dashed var(–beige-dark);background:transparent;font-family:‘Jost’,sans-serif;font-size:.68rem;letter-spacing:1.5px;text-transform:uppercase;color:var(–text-mid);cursor:pointer;transition:all .2s}
.abtn:hover{border-color:var(–rose-deep);color:var(–rose-deep);background:var(–rose-light);border-style:solid}

/* PARTICIPANTS */
.prow{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:18px}
.pchip{display:flex;align-items:center;gap:6px;padding:4px 11px 4px 4px;background:var(–white);border:1px solid var(–beige-dark);border-radius:100px;font-size:.73rem;box-shadow:var(–sh)}
.pav{width:23px;height:23px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.62rem;font-weight:600;color:white}
.ponline{width:5px;height:5px;border-radius:50%;background:#7bc47a;box-shadow:0 0 0 2px rgba(123,196,122,.25)}

/* COUNTDOWN */
.cdw{background:linear-gradient(135deg,var(–rose-light),var(–beige));border-radius:var(–r);padding:20px 18px;display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;flex-wrap:wrap;gap:12px;border:1px solid rgba(201,153,154,.18);box-shadow:var(–sh)}
.cdlabel{font-size:.65rem;letter-spacing:2.5px;text-transform:uppercase;color:var(–text-light);margin-bottom:5px}
.cdtitle{font-family:‘Cormorant Garamond’,serif;font-size:1.3rem;color:var(–text)}
.cdnums{display:flex;gap:10px}
.cdu{text-align:center}
.cdv{font-family:‘Cormorant Garamond’,serif;font-size:1.9rem;font-weight:500;color:var(–rose-deep);line-height:1}
.cdl{font-size:.55rem;letter-spacing:1.5px;text-transform:uppercase;color:var(–text-light);margin-top:2px}

/* BLOCK */
.block{background:rgba(254,252,250,.92);border-radius:var(–r);padding:22px 18px;border:1px solid rgba(224,211,180,.38);box-shadow:var(–sh);margin-bottom:12px;position:relative;transition:box-shadow .2s}
.block:hover{box-shadow:var(–sh2)}
.btop{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:12px;gap:8px;flex-wrap:wrap}
.btop-left{display:flex;align-items:center;gap:7px;flex-wrap:wrap}

/* ROLE DROPDOWN */
.rdd{position:relative}
.rddbtn{display:inline-flex;align-items:center;gap:4px;padding:3px 9px;border-radius:100px;font-family:‘Jost’,sans-serif;font-size:.58rem;letter-spacing:1.5px;text-transform:uppercase;cursor:pointer;font-weight:500;transition:opacity .15s;white-space:nowrap;border:1px solid transparent}
.rddbtn:hover{opacity:.8}
.rdd-all{background:var(–beige);color:var(–brown);border-color:var(–beige-dark)}
.rdd-temoin{background:var(–rose-light);color:var(–rose-deep);border-color:var(–rose-mid)}
.rdd-dh,.rdd-temoin-dh{background:rgba(139,158,138,.14);color:var(–sage-dark);border-color:rgba(139,158,138,.32)}
.rddmenu{position:absolute;top:calc(100% + 5px);left:0;background:var(–white);border:1px solid var(–beige-dark);border-radius:12px;box-shadow:var(–sh2);z-index:300;min-width:205px;overflow:hidden;animation:fadeUp .15s ease}
.rdditem{display:flex;align-items:center;gap:8px;padding:9px 13px;font-size:.77rem;color:var(–text);cursor:pointer;border:none;background:none;width:100%;text-align:left;font-family:‘Jost’,sans-serif;transition:background .12s}
.rdditem:hover{background:var(–rose-light)}.rdditem.cur{background:var(–beige);font-weight:500}
.rdot{width:7px;height:7px;border-radius:50%;flex-shrink:0}

/* BLOCK CONTROLS */
.bctrl{display:flex;gap:4px}
.cbtn{width:28px;height:28px;border-radius:7px;border:1px solid var(–beige-dark);background:var(–white);cursor:pointer;font-size:.78rem;display:flex;align-items:center;justify-content:center;transition:all .15s}
.cbtn:hover{background:var(–rose-light);border-color:var(–rose-deep)}
.cbtn.del:hover{background:#fde8e8;border-color:#e08080}

/* TEXT */
.btinput{font-family:‘Cormorant Garamond’,serif;font-size:1.28rem;font-weight:500;color:var(–text);border:none;background:transparent;outline:none;width:100%;padding:2px 4px;border-radius:5px;margin-bottom:9px;transition:background .2s}
.btinput:focus{background:rgba(232,196,196,.1)}
.bbinput{font-family:‘Jost’,sans-serif;font-size:.86rem;color:var(–text-mid);line-height:1.75;border:none;background:transparent;outline:none;width:100%;resize:none;transition:background .2s;border-radius:5px;padding:3px;min-height:56px;white-space:pre-wrap}
.bbinput:focus{background:rgba(242,234,211,.28)}

/* TABLE */
.tacts{display:flex;gap:7px;margin-bottom:9px;flex-wrap:wrap}
.twrap{overflow-x:auto;border-radius:10px;border:1px solid var(–beige-dark)}
table{width:100%;border-collapse:collapse;font-size:.83rem;min-width:300px}
th{background:linear-gradient(135deg,var(–rose-light),var(–beige));padding:9px 13px;font-family:‘Jost’,sans-serif;font-weight:500;font-size:.63rem;letter-spacing:2px;text-transform:uppercase;color:var(–text-mid);border-bottom:1px solid var(–beige-dark);text-align:left}
td{padding:9px 13px;border-bottom:1px solid rgba(224,211,180,.28);color:var(–text);vertical-align:top}
tr:last-child td{border-bottom:none}
tr:hover td{background:rgba(247,234,234,.18)}
th[contenteditable=“true”],td[contenteditable=“true”]{outline:none}
th[contenteditable=“true”]:focus{background:rgba(201,153,154,.14)}
td[contenteditable=“true”]:focus{background:rgba(242,234,211,.38);border-radius:3px}
.stbtn{padding:5px 11px;border:1px dashed var(–beige-dark);border-radius:7px;background:transparent;font-family:‘Jost’,sans-serif;font-size:.66rem;letter-spacing:1px;text-transform:uppercase;color:var(–text-light);cursor:pointer;transition:all .2s}
.stbtn:hover{border-color:var(–sage);color:var(–sage-dark);background:rgba(139,158,138,.08);border-style:solid}

/* CHECKLIST */
.chkitem{display:flex;align-items:flex-start;gap:9px;padding:8px 0;border-bottom:1px solid rgba(224,211,180,.2)}
.chkitem:last-child{border-bottom:none}
.ccb{width:18px;height:18px;border-radius:50%;border:2px solid var(–rose-deep);appearance:none;-webkit-appearance:none;cursor:pointer;flex-shrink:0;margin-top:2px;transition:all .2s;position:relative}
.ccb:checked{background:var(–rose-deep)}
.ccb:checked::after{content:‘✓’;position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);color:white;font-size:9px;font-weight:700}
.clabel{font-family:‘Jost’,sans-serif;font-size:.86rem;color:var(–text);border:none;background:transparent;outline:none;flex:1;line-height:1.5;transition:color .2s;padding:1px 0}
.chkitem.done .clabel{color:var(–text-light);text-decoration:line-through}
.atag{font-size:.6rem;color:var(–text-light);padding:1px 7px;border-radius:100px;background:var(–beige);border:1px solid var(–beige-dark);white-space:nowrap;font-family:‘Jost’,sans-serif;flex-shrink:0;margin-top:2px}

/* IMAGE */
.izone{border:2px dashed var(–beige-dark);border-radius:12px;padding:32px 18px;text-align:center;cursor:pointer;transition:all .25s;background:rgba(247,234,234,.07)}
.izone:hover{border-color:var(–rose-deep);background:var(–rose-light)}
.izone-ico{font-size:2rem;margin-bottom:9px}
.izone-txt{font-size:.75rem;color:var(–text-light);line-height:1.5}
.igrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:9px;margin-top:10px}
.ithumb{border-radius:9px;overflow:hidden;aspect-ratio:1;position:relative;cursor:zoom-in}
.ithumb img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .3s}
.ithumb:hover img{transform:scale(1.04)}
.idelbtn{position:absolute;top:4px;right:4px;background:rgba(0,0,0,.42);color:white;border:none;border-radius:5px;width:22px;height:22px;cursor:pointer;font-size:.65rem;display:none;align-items:center;justify-content:center}
.ithumb:hover .idelbtn{display:flex}.idelbtn:hover{background:rgba(180,60,60,.8)}

/* KIT */
.kgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(100px,1fr));gap:7px;margin-top:10px}
.kitem{padding:9px 6px;background:var(–beige);border-radius:9px;text-align:center;font-size:.7rem;color:var(–text-mid);border:1px solid var(–beige-dark);cursor:pointer;transition:all .2s;line-height:1.4}
.kitem:hover{background:var(–rose-light);border-color:var(–rose-mid)}
.kitem.on{background:rgba(139,158,138,.15);border-color:rgba(139,158,138,.4);color:var(–sage-dark)}
.kemo{font-size:1.15rem;display:block;margin-bottom:3px}

/* COMMENTS */
.csec{margin-top:16px;padding-top:14px;border-top:1px dashed rgba(224,211,180,.45)}
.ctoggle{display:flex;align-items:center;gap:6px;font-size:.68rem;letter-spacing:1.5px;text-transform:uppercase;color:var(–text-light);cursor:pointer;border:none;background:none;font-family:‘Jost’,sans-serif;padding:0;transition:color .2s;margin-bottom:10px}
.ctoggle:hover{color:var(–rose-deep)}
.ctcount{background:var(–rose-light);color:var(–rose-deep);padding:1px 7px;border-radius:100px;font-weight:600}
.clist{display:flex;flex-direction:column;gap:9px;margin-bottom:10px}
.comment{display:flex;gap:8px;align-items:flex-start}
.cav{width:26px;height:26px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.68rem;font-weight:600;color:white;flex-shrink:0}
.cbody{flex:1}
.cmeta{display:flex;align-items:center;gap:7px;margin-bottom:2px}
.cname{font-size:.74rem;font-weight:600;color:var(–text)}
.ctime{font-size:.63rem;color:var(–text-light)}
.ctext{font-size:.8rem;color:var(–text-mid);line-height:1.55}
.cinput-row{display:flex;gap:7px;align-items:flex-end}
.cinput{flex:1;padding:8px 12px;border:1.5px solid var(–beige-dark);border-radius:20px;font-family:‘Jost’,sans-serif;font-size:.82rem;color:var(–text);outline:none;resize:none;background:var(–white);max-height:110px;overflow-y:auto;transition:border-color .2s;line-height:1.5}
.cinput:focus{border-color:var(–rose-deep)}
.csendbtn{width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,var(–rose-deep),var(–sage-light));border:none;color:white;font-size:.9rem;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .2s;flex-shrink:0}
.csendbtn:hover{transform:scale(1.08)}

/* MODAL */
.mbackdrop{position:fixed;inset:0;background:rgba(61,51,42,.33);backdrop-filter:blur(5px);-webkit-backdrop-filter:blur(5px);z-index:400;display:none;align-items:flex-end;justify-content:center;padding:0 0 env(safe-area-inset-bottom)}
.mbackdrop.open{display:flex}
@media(min-width:560px){.mbackdrop{align-items:center;padding:20px}}
.modal{background:var(–white);border-radius:20px 20px 0 0;padding:26px 20px 30px;width:100%;max-width:450px;box-shadow:var(–sh2);border:1px solid rgba(224,211,180,.28);animation:slideUp .26s ease}
@media(min-width:560px){.modal{border-radius:20px}}
@keyframes slideUp{from{opacity:0;transform:translateY(36px)}to{opacity:1;transform:translateY(0)}}
.mhandle{width:34px;height:3px;border-radius:2px;background:var(–beige-dark);margin:0 auto 16px}
.mtitle{font-family:‘Cormorant Garamond’,serif;font-size:1.45rem;margin-bottom:4px}
.msub{font-size:.68rem;color:var(–text-light);letter-spacing:2px;text-transform:uppercase;margin-bottom:20px}
.mgrid{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-bottom:16px}
.mopt{padding:16px 10px;border:1.5px solid var(–beige-dark);border-radius:13px;background:var(–white);cursor:pointer;text-align:center;display:flex;flex-direction:column;align-items:center;gap:6px;transition:all .2s}
.mopt:hover{border-color:var(–rose-deep);background:var(–rose-light);transform:translateY(-1px)}
.mopticon{font-size:1.6rem}.moptname{font-size:.65rem;letter-spacing:1.5px;text-transform:uppercase;color:var(–text-mid)}
.mfield{margin-bottom:13px}
.mlabel{font-size:.63rem;letter-spacing:2px;text-transform:uppercase;color:var(–text-mid);margin-bottom:6px;display:block}
.mselect{width:100%;padding:10px 13px;border:1.5px solid var(–beige-dark);border-radius:var(–rs);font-family:‘Jost’,sans-serif;font-size:.86rem;color:var(–text);background:var(–white);outline:none}
.macts{display:flex;gap:8px;justify-content:flex-end}
.mcancel{padding:9px 18px;border:1px solid var(–beige-dark);border-radius:var(–rs);background:transparent;font-family:‘Jost’,sans-serif;font-size:.74rem;color:var(–text-mid);cursor:pointer;transition:all .2s}
.mcancel:hover{background:var(–beige)}

/* LIGHTBOX */
.lbox{position:fixed;inset:0;background:rgba(28,20,12,.92);z-index:9000;display:none;align-items:center;justify-content:center}
.lbox.open{display:flex}
.lbox img{max-width:92vw;max-height:88vh;border-radius:12px;object-fit:contain}
