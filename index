}

function renderCD(id, date, label) {
  const el = document.getElementById(id); if (!el) return;
  const diff = date - new Date();
  if (diff <= 0) { el.style.display = 'none'; return; }
  const d = Math.floor(diff / 86400000);
  const h = Math.floor((diff % 86400000) / 3600000);
  const m = Math.floor((diff % 3600000) / 60000);
  el.innerHTML = `<div><div class="cdlabel">Compte à rebours</div><div class="cdtitle">${label}</div></div>
    <div class="cdnums">
      <div class="cdu"><div class="cdv">${d}</div><div class="cdl">Jours</div></div>
      <div class="cdu"><div class="cdv">${h}</div><div class="cdl">Heures</div></div>
      <div class="cdu"><div class="cdv">${m}</div><div class="cdl">Min</div></div>
    </div>`;
}

